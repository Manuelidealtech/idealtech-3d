# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Recommended 2026 key names
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxx

# Legacy Supabase key names are also supported by this project:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Blob
# With a Blob store connected to this Vercel project, production uses OIDC.
# BLOB_READ_WRITE_TOKEN is NOT required for Vercel production deployments using OIDC.
