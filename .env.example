# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Blob
# On Vercel, Blob uses OIDC when the store is connected to this project.
# No BLOB_READ_WRITE_TOKEN is required for production deployments using OIDC.
# Run `vercel env pull .env.local` for local Vercel-linked development if needed.
